            # PostgreSQL Docker Configuration (primary database — agent pipeline)
# Copy this file to .env.docker and fill in the values

# PostgreSQL superuser name (default: postgres)
POSTGRES_USER=postgres

# PostgreSQL password
POSTGRES_PASSWORD=YourPostgresP4ssw0rd

# Database name (default: talent_finder)
POSTGRES_DB=talent_finder

# Port mapping for PostgreSQL (default: 5432)
POSTGRES_PORT=5432

# SQL Server Docker Configuration (legacy — deprecated, Next.js/Prisma only)

# SQL Server SA (System Administrator) password
# Must be at least 8 characters and contain uppercase, lowercase, numbers, and special characters
MSSQL_SA_PASSWORD=YourComplex!P4ssw0rd

# Database name (default: talent_finder)
MSSQL_DATABASE=talent_finder

# Port mapping for SQL Server (default: 1433)
MSSQL_PORT=1433

# Langfuse Docker Configuration (LLM observability — self-hosted)

# Langfuse metadata database password
LANGFUSE_DB_PASSWORD=langfuse

# Langfuse metadata database port (default: 5433, separate from pipeline Postgres)
LANGFUSE_DB_PORT=5433

# Langfuse web UI port (default: 3000)
LANGFUSE_PORT=3000

# NextAuth secret for Langfuse (any random string)
LANGFUSE_NEXTAUTH_SECRET=mysecret

# Langfuse encryption salt (any random string)
LANGFUSE_SALT=mysalt
