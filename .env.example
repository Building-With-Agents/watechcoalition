# Updated 8/27/2024
# Gary Larson

#######################################################################
##################### Copy file and rename to .env ####################
#######################################################################

# NextAuth
AUTH_SECRET= # use `openssl rand -base64 32` to generate (not sure if we need this variable anymore)

# OAuth (see readme.md)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

#email stuff (Resend)
EMAIL_SENDER=no-reply@mail.watechcoalition.org
EMAIL_RESEND_API_KEY=

# Azure Services - AI (resume parsing)
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME=chat-gpt41mini

# Azure Services - Embeddings
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_API_VERSION="2024-02-01"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=embeddings-te3small

# N8N keys
N8N_JOBSEEKER_CHAT_BOT=

# Azure Services - Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
# SAS Token Generation
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_NAME=

# Connection String for MSSQL
DATABASE_URL=

# AI Workforce Contacts - Logic Apps Endpoint for Sharepoint Lists
AI_DEV_ENDPOINT=https://your-logic-app-endpoint-url
# Career Prep (Deprecated but still active)
CP_APPLICATION_ENDPOINT=https://your-career-prep-endpoint

#Azure DB with mock data assign to DATABASE_URL
AZURE_DB_CONNECTION_STRING=mssql://cfa:superPass123@cfa-test.database.windows.net:1433/Test

# =============================================================================
# Agent Pipeline (Python) — Job Intelligence Engine
# =============================================================================
PYTHONIOENCODING=utf-8  # Required on Windows to prevent Crawl4AI unicode errors
# Available: azure_openai (chat-gpt41mini) | mock (ground truth, no API calls) | anthropic | openai
LLM_PROVIDER=azure_openai
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true

# Langfuse Observability (cloud or local Docker)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Cloud: https://us.cloud.langfuse.com  |  Local Docker: http://localhost:3000
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Python agent database connection (SQLAlchemy + psycopg2 → PostgreSQL)
# IMPORTANT: This is different from DATABASE_URL above (which uses Prisma's sqlserver:// syntax for the Next.js app).
# The agent pipeline uses PostgreSQL; the Next.js app still uses MSSQL (a future DB-unification effort will consolidate both on PostgreSQL).
#
# Option A — Local Docker PostgreSQL:
# PYTHON_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/talent_finder
# The host port must match POSTGRES_PORT in .env.docker (docker-compose default is 5432).
#
# Option B — Azure PostgreSQL (recommended for class):
PYTHON_DATABASE_URL=postgresql+psycopg2://azadmin:<password>@pg-jobintel-cfa-dev.postgres.database.azure.com:5432/talent_finder?sslmode=require

# Convenience alias — same Azure URL for scripts that reference this name
AZURE_POSTGRES_DATABASE_URL=postgresql+psycopg2://azadmin:<password>@pg-jobintel-cfa-dev.postgres.database.azure.com:5432/talent_finder?sslmode=require

# Read source for agents/scripts/sync_embeddings_from_azure.py (optional: falls back to AZURE_POSTGRES_DATABASE_URL)
# AZURE_DATABASE_URL=postgresql+psycopg2://azadmin:<password>@pg-jobintel-cfa-dev.postgres.database.azure.com:5432/talent_finder?sslmode=require

# Message bus (Redis Streams — inter-agent event communication)
REDIS_URL=redis://localhost:6379/0

# Ingestion
JSEARCH_API_KEY=
SCRAPING_TARGETS=                        # Comma-separated target URLs
INGESTION_SCHEDULE=0 2 * * *            # Cron — default: daily at 2am

# Pipeline thresholds
SPAM_FLAG_THRESHOLD=0.7                  # Flag for operator review above this
SPAM_REJECT_THRESHOLD=0.9               # Auto-reject above this
SKILL_CONFIDENCE_THRESHOLD=0.75
SKILLS_EXTRACTION_PARALLEL=1            # Run intra-job + inter-job async extraction
SKILLS_EXTRACTION_CONCURRENCY=5         # Max jobs in flight when parallel mode is enabled
# Deprecated serial-only throttles; only used when SKILLS_EXTRACTION_PARALLEL=0
SKILLS_EXTRACTION_CHUNK_SIZE=5
SKILLS_EXTRACTION_CHUNK_COOLDOWN=30
SKILLS_EXTRACTION_DELAY=1.0
BATCH_SIZE=100

# --- Analytics Guardrails (Week 7, Pair D) ---
STALENESS_THRESHOLD_MINUTES=15      # Minutes before aggregate table computed_at is considered stale (triggers AnalyticsStaleAlert)
CARDINALITY_CAP=500                 # Max distinct values per category dimension before overflow coalesces to "Other" (triggers CardinalityWarning)
FRESH_THRESHOLD_DAYS=30             # Postings newer than this = "fresh" in classify_freshness()
STALE_THRESHOLD_DAYS=90             # Postings older than this = "expired"; between FRESH and STALE = "stale"
